APP_NAME=MeetingAgent Backend
ENVIRONMENT=local
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=["*"]

DATABASE_URL=postgresql+asyncpg://meetingagent:meetingagent@db:5432/meetingagent
DATABASE_CONNECT_RETRIES=20
DATABASE_CONNECT_RETRY_DELAY_SECONDS=2.0

JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

YANDEX_CLOUD_FOLDER_ID=your-folder-id
YANDEX_IAM_TOKEN=
YANDEX_CLOUD_API_KEY=
YANDEX_GPT_MODEL=yandexgpt-5.1
YANDEX_GPT_MODEL_VERSION=pro
YANDEX_GPT_TEMPERATURE=0.3
YANDEX_GPT_MAX_TOKENS=2000

SPEECHKIT_ENDPOINT=stt.api.cloud.yandex.net:443
SPEECHKIT_LANGUAGE_CODE=ru-RU
SPEECHKIT_SAMPLE_RATE_HERTZ=16000
SPEECHKIT_AUDIO_CHANNELS=1
SPEECHKIT_MODEL=general:rc
SPEECHKIT_PROCESSING_TYPE=FULL_DATA
SPEECHKIT_CHUNK_SIZE_BYTES=4096

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
